[configuration]
entry_symbol = "dansu_bpm_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]
windows.debug.x86_64 = "res://addons/dansu_bpm/bin/dansu_bpm.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/dansu_bpm/bin/dansu_bpm.windows.template_release.x86_64.dll"

[dependencies]
windows.x86_64 = {
    "res://addons/dansu_bpm/bin/onnxruntime.dll": "",
    "res://addons/dansu_bpm/bin/onnxruntime_providers_shared.dll": "",
    "res://addons/dansu_bpm/bin/DirectML.dll": "",
    "res://addons/dansu_bpm/bin/soxr.dll": "",
    "res://addons/dansu_bpm/bin/libsndfile_x64.dll": ""
}
